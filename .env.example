# Local-only configuration; never reuse another project's credentials implicitly.
DB_PASSWORD=local-development-only
DB_URL=jdbc:postgresql://127.0.0.1:15432/insightradar_v002
DB_USER=insightradar
# Optional directory containing PostgreSQL 17 executables; common install paths are detected.
# PG_BIN=/opt/homebrew/opt/postgresql@17/bin
API_PORT=18080
LLM_BASE_URL=
LLM_API_KEY=
# Optional existing env file containing OPENAI_API_KEY, loaded by scripts/start.sh.
LLM_KEY_ENV_FILE=
LLM_MODEL=
LLM_HTTP_PROXY=
LLM_MONTHLY_BUDGET_USD=100
DISCLOSURE_MAX_PDFS=8
